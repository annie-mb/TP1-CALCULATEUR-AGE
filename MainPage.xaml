<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur d'Âge MVVM">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre nom"/>

            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}"/>

            <!-- Boutons de commande -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Calculer" Command="{Binding CalculerCommand}"/>
                <Button Grid.Column="1" Text="Effacer" Command="{Binding EffacerCommand}" BackgroundColor="Gray"/>
            </Grid>

            <!-- Résultats liés au ViewModel -->
            <VerticalStackLayout IsVisible="{Binding ResultatVisible}" Spacing="6" Margin="0,15,0,0">
                <Label Text="{Binding Resultat}" FontSize="20" FontAttributes="Bold" TextColor="DarkBlue"/>
                <Label Text="{Binding Statut}" FontSize="16" TextColor="DarkSlateGray"/>
                <Label Text="{Binding ProchainAnniversaire}" FontSize="15" TextColor="DarkGreen"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>